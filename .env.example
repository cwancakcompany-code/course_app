SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional aliases
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Free Tier magic-link redirect (also add in Supabase → Auth → URL Configuration)
# Must ALSO be in Supabase → Authentication → URL Configuration:
# Site URL = edumaster://login-callback/
# Redirect URLs = edumaster://login-callback/**
SUPABASE_AUTH_REDIRECT_URL=edumaster://login-callback/

# Optional: For Native Google Sign-In with ID Token verification in Supabase
# GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
